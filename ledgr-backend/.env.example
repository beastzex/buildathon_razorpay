# Ledgr AI Finance Controller — Environment Configuration

# Database: PostgreSQL + pgvector (or fallback SQLite: sqlite+aiosqlite:///./ledgr.db)
DATABASE_URL=postgresql+asyncpg://ledgr:ledgrpass@localhost:5432/ledgr

# Redis / Celery Task Queue
REDIS_URL=redis://localhost:6379/0

# Groq API Configuration for Exception Explanation & Settlement Q&A
GROQ_API_KEY=your_groq_api_key_here
LEDGR_GROQ_MODEL=openai/gpt-oss-120b
LEDGR_GROQ_TIMEOUT=8.0

# Two-Stage Reconciliation Gate Thresholds (Configurable)
LEDGR_AUTO_MATCH_THRESHOLD=0.85
LEDGR_REVIEW_THRESHOLD=0.65
LEDGR_EMBEDDING_WEIGHT=0.45
LEDGR_RULE_WEIGHT=0.55

# Rule Verifier Constraints
LEDGR_MAX_DATE_LAG_DAYS=2
LEDGR_MAX_FEE_TOLERANCE_PCT=2.5
LEDGR_MAX_FIXED_FEE=50.0
LEDGR_MIN_REF_FUZZY_SCORE=65.0
